# =============================================================================
# the-array - environment template
#
# Copy this file to .env, replace every CHANGE_ME, and NEVER commit .env (it is
# gitignored; only this example is tracked). Every variable the compose file
# reads is listed here. Provider keys you do not use may be left empty.
# =============================================================================

# --- Compose ---------------------------------------------------------------
# Fixes container / volume / network names regardless of the checkout
# directory name. Changing it later orphans the existing volumes.
COMPOSE_PROJECT_NAME=praxen

# --- PostgreSQL (gateway state: keys, teams, budgets, spend logs) ----------
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=litellm

# --- LiteLLM gateway -------------------------------------------------------
# Master key: must begin with LiteLLM's standard key prefix (the letters "sk"
# followed by a dash) and then 32+ random characters. Keep it API-only; the
# admin UI signs in with the separate login below.
LITELLM_MASTER_KEY=CHANGE_ME
UI_USERNAME=admin
UI_PASSWORD=CHANGE_ME

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Shared secret between Grafana and the image renderer. Grafana 13 refuses to
# boot with the default token, so this MUST be set (any long random string).
RENDERER_AUTH_TOKEN=CHANGE_ME

# --- SearXNG ---------------------------------------------------------------
# Overrides server.secret_key in searxng_settings.yml (any long random string).
SEARXNG_SECRET=CHANGE_ME

# --- n8n (agents / full / dev profiles only) -------------------------------
# No login variables: n8n removed basic auth at 1.0 and prompts for an owner
# account on first launch; its port is loopback-only in the compose file.
# It generates its credential encryption key on first launch and keeps it on
# the n8ndata volume. Set this ONLY to pin that key (and uncomment the matching
# passthrough in docker-compose.yml) - never a placeholder value.
# N8N_ENCRYPTION_KEY=

# --- Local inference (OpenAI-compatible servers, e.g. LM Studio) -----------
# host.docker.internal resolves to the Docker host from inside a container.
# A host-side probe proves nothing - the gateway container's view is what counts.
WINDOWS_LM_STUDIO_URL=http://host.docker.internal:1234/v1
# Optional second inference box on the LAN, e.g. http://<lan-ip>:1234/v1.
# Passed through to the gateway but NOT referenced by litellm_config.example.yaml
# as shipped - it does nothing until a route sets its api_base to it. Leave
# empty on one machine; verify it from INSIDE the gateway container first.
SECOND_LM_STUDIO_URL=

# --- Provider API keys -----------------------------------------------------
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
MISTRAL_API_KEY=CHANGE_ME
PERPLEXITY_API_KEY=CHANGE_ME
COHERE_API_KEY=CHANGE_ME
XAI_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME
HUGGINGFACE_API_KEY=CHANGE_ME
MERCURY_API_KEY=CHANGE_ME
# Private lane: read by the api_base-pinned private-* entries in
# litellm_config.example.yaml (os.environ/PRIVATE_INFERENCE_API_KEY).
PRIVATE_INFERENCE_API_KEY=CHANGE_ME
