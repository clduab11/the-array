    {
      "id": 102,
      "type": "stat",
      "title": "MATCHED REQUESTS",
      "description": "Requests in the range that match the pickers and, if one is set, the selected request.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "praxen-litellm-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "praxen-litellm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS \"matched\" FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") AND ('${request_id}' = '' OR request_id = '${request_id}' OR metadata->>'litellm_call_id' = '${request_id}') AND COALESCE(metadata->>'user_api_key_alias','') ~ '^(?:${key:regex})$' AND COALESCE(model_group,'') ~ '^(?:${model:regex})$' AND COALESCE(metadata->>'user_api_key_team_alias','') ~ '^(?:${team:regex})$'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4A6B8A",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
