    {
      "id": 113,
      "type": "table",
      "title": "Request timeline // selected request",
      "description": "The selected request's own timestamps — received, first token, completed — with its duration, fallbacks and retries. Empty until a request is selected.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "praxen-litellm-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "praxen-litellm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH r AS (SELECT * FROM \"LiteLLM_SpendLogs\" WHERE '${request_id}' <> '' AND (request_id = '${request_id}' OR metadata->>'litellm_call_id' = '${request_id}') LIMIT 1) SELECT \"startTime\" AS \"time\", 'request received' AS event, COALESCE(NULLIF(model_group,''), model) || ' · ' || COALESCE(NULLIF(metadata->>'user_api_key_alias',''),'-') AS detail FROM r UNION ALL SELECT \"completionStartTime\", 'first token', 'ttft ' || ROUND(EXTRACT(EPOCH FROM (\"completionStartTime\" - \"startTime\")) * 1000)::text || ' ms · served by ' || COALESCE(model,'-') FROM r UNION ALL SELECT \"endTime\", 'response ' || COALESCE(status,'?'), request_duration_ms::text || ' ms · fallbacks ' || COALESCE(metadata->>'attempted_fallbacks','0') || ' · retries ' || COALESCE(metadata->>'attempted_retries','0') || COALESCE(' · ' || NULLIF(metadata->'error_information'->>'error_class',''), '') FROM r ORDER BY 1"
        }
      ],
