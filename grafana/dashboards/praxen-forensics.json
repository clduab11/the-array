    {
      "id": 108,
      "type": "table",
      "title": "Request log // verbose (range · filters · selected request)",
      "description": "Full detail for each matching request: ids, key, team, route asked for, model that answered, provider, success or failure with the error class, timings, tokens, dollars, billed tier, fallbacks, retries and the router's decision. Paste a request id or call id at the top — or click one here — to focus every panel on it.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "praxen-litellm-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "praxen-litellm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT \"startTime\" AS \"time\", request_id, metadata->>'litellm_call_id' AS call_id, COALESCE(NULLIF(metadata->>'user_api_key_alias',''),'-') AS key, COALESCE(NULLIF(metadata->>'user_api_key_team_alias',''),'-') AS team, COALESCE(NULLIF(model_group,''),'-') AS route, COALESCE(NULLIF(model,''),'-') AS model, COALESCE(NULLIF(custom_llm_provider,''),'-') AS provider, COALESCE(NULLIF(regexp_replace(api_base, '^(https?://[^/]+).*$', '\\1'),''),'-') AS host, COALESCE(NULLIF(status,''),'?') AS status, NULLIF(TRIM(COALESCE(metadata->'error_information'->>'error_class','') || ' ' || COALESCE(metadata->'error_information'->>'error_code','')),'') AS error, request_duration_ms AS ms, ROUND(EXTRACT(EPOCH FROM (\"completionStartTime\" - \"startTime\")) * 1000)::int AS ttft_ms, prompt_tokens AS in_tok, completion_tokens AS out_tok, COALESCE((metadata->'usage_object'->'prompt_tokens_details'->>'cached_tokens')::bigint, (metadata->'usage_object'->>'cache_read_input_tokens')::bigint, 0) AS cached_tok, round(spend::numeric,5) AS usd, COALESCE(metadata->'cost_breakdown'->>'service_tier','-') AS tier, COALESCE((metadata->>'attempted_fallbacks')::int,0) AS fallbacks, COALESCE((metadata->>'attempted_retries')::int,0) AS retries, NULLIF(TRIM(COALESCE(metadata->'routing_decision'->>'tier','') || ' ' || COALESCE(metadata->'routing_decision'->>'cause','')),'') AS routing, COALESCE(session_id,'') AS session FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") AND ('${request_id}' = '' OR request_id = '${request_id}' OR metadata->>'litellm_call_id' = '${request_id}') AND COALESCE(metadata->>'user_api_key_alias','') ~ '^(?:${key:regex})$' AND COALESCE(model_group,'') ~ '^(?:${model:regex})$' AND COALESCE(metadata->>'user_api_key_team_alias','') ~ '^(?:${team:regex})$' ORDER BY \"startTime\" DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2F8F72",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "#2F8F72",
                        "index": 0
                      },
                      "failure": {
                        "color": "#A8453F",
                        "index": 1
                      },
                      "?": {
                        "color": "#6B7681",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 5
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "request_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Select this request",
                    "url": "/d/praxen-forensics/praxen-forensics?${__url_time_range}&var-key=${key:queryparam}&var-model=${model:queryparam}&var-team=${team:queryparam}&var-interval=${interval:queryparam}&var-request_id=${__data.fields.request_id}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "call_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
