    {
      "id": 104,
      "type": "stat",
      "title": "P95 LATENCY",
      "description": "95 out of 100 matching requests finished faster than this.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "praxen-litellm-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "praxen-litellm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY request_duration_ms) AS \"p95_ms\" FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") AND request_duration_ms IS NOT NULL AND ('${request_id}' = '' OR request_id = '${request_id}' OR metadata->>'litellm_call_id' = '${request_id}') AND COALESCE(metadata->>'user_api_key_alias','') ~ '^(?:${key:regex})$' AND COALESCE(model_group,'') ~ '^(?:${model:regex})$' AND COALESCE(metadata->>'user_api_key_team_alias','') ~ '^(?:${team:regex})$'"
        }
