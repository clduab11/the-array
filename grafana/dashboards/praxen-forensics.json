    {
      "id": 105,
      "type": "stat",
      "title": "FALLBACKS",
      "description": "Matching requests where the proxy had to try another model.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "praxen-litellm-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "praxen-litellm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS \"fallbacks\" FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") AND (COALESCE((metadata->>'attempted_fallbacks')::int, 0) > 0 OR (metadata->>'original_model_group' IS NOT NULL AND metadata->>'original_model_group' <> model_group)) AND ('${request_id}' = '' OR request_id = '${request_id}' OR metadata->>'litellm_call_id' = '${request_id}') AND COALESCE(metadata->>'user_api_key_alias','') ~ '^(?:${key:regex})$' AND COALESCE(model_group,'') ~ '^(?:${model:regex})$' AND COALESCE(metadata->>'user_api_key_team_alias','') ~ '^(?:${team:regex})$'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
