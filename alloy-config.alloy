// =============================================================================
// Grafana Alloy configuration - container logs -> Loki
//
// Pipeline: discovery.docker -> discovery.relabel -> loki.source.docker -> loki.write
// Reads every container's log stream through the Docker socket bind-mounted by
// compose. On Docker Desktop this needs Settings -> Advanced -> "Allow the
// default Docker socket to be used" (the socket is bind-mounted into the VM).
// Cursor positions persist on the alloydata volume (/var/lib/alloy/data) so logs
// are not re-read from scratch on restart. Validate edits with `alloy validate`.
// =============================================================================

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Docker API reports names with a leading slash ("/praxen-litellm") - strip it.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  labels        = {"job" = "docker"}
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
