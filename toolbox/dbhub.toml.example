# DBHub - the toolbox's one database tool, read-only, for the gateway's spend ledger.
# Copy to ~/.config/toolbox/dbhub.toml (the path toolbox.yaml passes with --config).
#
# Before it works:
#   1. Create a database role that can only SELECT (ideally only from "LiteLLM_SpendLogs"). The gateway
#      database also holds key hashes and config rows, so never hand a tool the gateway's own login.
#   2. Set the environment variable SPEND_RO_DSN to that role's connection string, e.g.
#      postgres://spend_reader:<password>@localhost:5432/litellm?sslmode=disable
#
# readonly lives ONLY here. A DBHub launched with just --dsn can write, so always launch with --config.
# DBHub reloads this file when it changes.

[[sources]]
id = "spend"
description = "gateway spend ledger (read-only role)"
dsn = "${SPEND_RO_DSN}"
lazy = true
connection_timeout = 10
query_timeout = 20

[[tools]]
name = "execute_sql"
source = "spend"
readonly = true
max_rows = 500

[[tools]]
name = "search_objects"
source = "spend"
