{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/99_private-folder/**)",
      "Read(/.obsidian/**)",
      "Read(/.vault-operator/**)",
      "Read(/.trash/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/opencode.jsonc)",
      "Edit(/.ignore)",
      "Edit(/**/.mstyignore)",
      "Edit(/.obsidian-agentignore)",
      "Edit(/.obsidian-agentprotected)",
      "Edit(/**/CONTEXT.md)",
      "Edit(/**/GEMINI.md)",
      "Edit(/**/AGENT.md)",
      "Bash(*Obsidian.* delete *permanent*)",
      "Bash(*Obsidian.* create *overwrite*)",
      "Bash(*Obsidian.* eval*)",
      "Bash(*Obsidian.* command *)",
      "Bash(*Obsidian.* plugin*)",
      "Bash(*Obsidian.* theme*)",
      "Bash(*Obsidian.* snippet*)",
      "Bash(*Obsidian.* sync*)",
      "Bash(*Obsidian.* history:restore*)",
      "Bash(*Obsidian.* dev*)",
      "Bash(*Obsidian.* web *)",
      "Bash(*Obsidian.* reload*)",
      "Bash(*Obsidian.* restart*)",
      "PowerShell(*Obsidian.* delete *permanent*)",
      "PowerShell(*Obsidian.* create *overwrite*)",
      "PowerShell(*Obsidian.* eval*)",
      "PowerShell(*Obsidian.* command *)",
      "PowerShell(*Obsidian.* plugin*)",
      "PowerShell(*Obsidian.* theme*)",
      "PowerShell(*Obsidian.* snippet*)",
      "PowerShell(*Obsidian.* sync*)",
      "PowerShell(*Obsidian.* history:restore*)",
      "PowerShell(*Obsidian.* dev*)",
      "PowerShell(*Obsidian.* web *)",
      "PowerShell(*Obsidian.* reload*)",
      "PowerShell(*Obsidian.* restart*)"
    ]
  },
  "claudeMdExcludes": [
    "**/praxen-vault/*/**/{CLAUDE,claude}.md",
    "**/praxen-vault/*/**/{CLAUDE,claude}.local.md",
    "**/praxen-vault/*/**/{AGENTS,agents}.md",
    "**/praxen-vault/*/**/.claude/rules/**"
  ]
}
