# =============================================================================
# PRAXEN — Environment Variables Template
# Version: 2.0.2 | Updated: 2026-09-23 (+SEARXNG_SECRET for compose v1.7.13)
# Prior: 2.0.1 2026-09-16 (+GRAFANA_SMTP_* for compose v1.7.9 spend alerts, +GATEWAY_ADMIN_TOKEN for the Gateway scripts)
# Prior: 2.0.0 2026-09-10 (OP REPO-READY — reconciled to the LIVE .env + compose v1.7.7)
# Copy to .env and fill every CHANGE_ME. Never commit .env.
#
# v2.0.0: the v1.1.0 template (2026-05-20) had drifted 8 key names behind the running
# stack for months — anyone following it got a dead stack (no UI login, no renderer
# token so Grafana boot-failed, no GROQ/HF/MERCURY keys so three provider lanes
# 401'd, no iMac URL so the imac-* routes 400'd). Every variable below is consumed
# by docker-compose.yml or litellm_config.yaml unless marked OPTIONAL / UNCONSUMED.
# =============================================================================

# --- Compose project name (LOCKED — decouples the Compose namespace from the
#     directory name; all container/volume names derive from it) ---
COMPOSE_PROJECT_NAME=praxen

# --- PostgreSQL (litellm-proxy + grafana litellm-postgres datasource) ---
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=litellm

# --- LiteLLM proxy ---
LITELLM_MASTER_KEY=CHANGE_ME       # sk-<32+ random chars>; the only key that can mint virtual keys
UI_USERNAME=CHANGE_ME              # admin UI login at http://localhost:4000/ui
UI_PASSWORD=CHANGE_ME

# --- Redis (consumed by litellm_config.yaml via os.environ/REDIS_HOST, REDIS_PORT;
#     not referenced by compose itself) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
RENDERER_AUTH_TOKEN=CHANGE_ME      # shared with grafana-image-renderer; Grafana 13 BOOT-FAILS on the default token
# Spend-watch email (compose v1.7.9, grafana/provisioning/alerting/praxen-spend-watch.yaml). Mail goes through the
# Proton Mail Bridge on the host (127.0.0.1:1025, reached as host.docker.internal:1025). USER/PASSWORD are Bridge's
# own per-account pair (Bridge GUI -> Mailbox details), NOT the Proton account password. ENABLED=false boots fine.
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=host.docker.internal:1025
GRAFANA_SMTP_USER=CHANGE_ME
GRAFANA_SMTP_PASSWORD=CHANGE_ME
GRAFANA_SMTP_FROM=CHANGE_ME

# --- SearXNG (compose v1.7.13) ---
# Overrides server.secret_key; searxng_settings.yml's "${SEARXNG_SECRET}" is literal YAML, not interpolated.
# Generate: python -c "import secrets; print(secrets.token_hex(32))". Compose refuses to start searxng without it.
SEARXNG_SECRET=CHANGE_ME

# --- n8n (agents profile only — never brought up as of 2026-09-10) ---
N8N_USER=admin                     # OPTIONAL: compose defaults to admin when unset
N8N_PASSWORD=CHANGE_ME

# --- Tailscale (sidecar RETIRED 2026-07-28, profile "retired" — value kept for the
#     parked service definition; expire the key if the sidecar never returns) ---
TS_AUTHKEY=CHANGE_ME               # <tailscale-auth-key><...>

# --- Local model servers (LM Studio, OpenAI-compatible, :1234) ---
# From INSIDE the proxy container the PC's LM Studio is host.docker.internal — NOT the
# Tailscale IP (unreachable from the container netns; every local rung was dead for a
# day in July 2026 because of that binding). Probe any new binding from inside the
# praxen-litellm netns before trusting it.
WINDOWS_LM_STUDIO_URL=http://host.docker.internal:1234/v1
# Second box (the iMac) reached DIRECT over LAN — its DHCP-reserved LAN address, not its
# tailnet address. Only the imac-* routes use it. Never point a local-* entry here.
SECOND_LM_STUDIO_URL=http://CHANGE_ME:1234/v1

# =============================================================================
# PROVIDER API KEYS — every one of these MUST ALSO appear in the litellm-proxy
# `environment:` block in docker-compose.yml (no env_file: is used). A key present
# here but absent from that block is silently orphaned: the provider's routes fail
# auth with no config error (GROQ/HUGGINGFACE/MERCURY sat orphaned 2026-06-01..06-15).
# =============================================================================
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
MISTRAL_API_KEY=CHANGE_ME
PERPLEXITY_API_KEY=CHANGE_ME
COHERE_API_KEY=CHANGE_ME
XAI_API_KEY=CHANGE_ME
VENICE_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME
HUGGINGFACE_API_KEY=CHANGE_ME
MERCURY_API_KEY=CHANGE_ME          # Inception Labs (mercury / mercury-coder entries)
TYPESAFE_API_KEY=CHANGE_ME         # TypeSafe AI Jev (v4.14.0): /typesafe pass-through + router classifier + soft-refusal judge (litellm/jev_gate.py)
VERTEX_API_KEY=CHANGE_ME           # UNCONSUMED as of 2026-09-10: present in the live .env but passed by
                                   # nothing in compose and referenced by nothing in the config (gemini/*
                                   # rides GEMINI_API_KEY). Kept so the live file and this template agree;
                                   # wire it through the proxy env block before adding any vertex_ai/* entry.

# --- Msty Gateway admin API — read by scripts/sync-gateway-models.py (and stashed by
#     scripts/stash-gateway-admin-token.ps1); NOT consumed by compose ---
GATEWAY_ADMIN_TOKEN=CHANGE_ME

# =============================================================================
# ALERTING (optional; the alerting block in litellm_config.yaml stays commented
# until this is set)
# =============================================================================
# SLACK_WEBHOOK_URL=                # Slack-shape webhook (Slack, Teams, Discord all accept it)

# =============================================================================
# VIRTUAL KEYS live in .virtual-keys.env (chmod 600), written by ./provision-keys.sh on a
# FRESH box only — the script rebuilds the file on every run, so never run it just
# to add one key (mint singles via POST /key/generate and append by hand). Both
# .env and .virtual-keys.env are gitignored. Never fill virtual keys in this file.
# =============================================================================
